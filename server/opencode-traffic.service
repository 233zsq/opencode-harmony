[Unit]
Description=Aggregate private per-project HTTP egress counters
[Service]
Type=oneshot
User=oc-traffic
Group=oc-traffic
ExecStart=/usr/bin/python3 -B /opt/opencode-account/traffic_summary.py
StateDirectory=opencode-traffic
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/opencode-traffic
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
TasksMax=16
MemoryMax=96M
