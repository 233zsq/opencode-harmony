[Unit]
Description=OpenCode private owner account
After=network.target
[Service]
User=oc-account
Group=oc-account
WorkingDirectory=/opt/opencode-account/current
EnvironmentFile=/etc/opencode-account/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/opencode-account/venv/bin/gunicorn --bind 127.0.0.1:4099 --workers 1 --worker-class gthread --threads 4 --timeout 30 --limit-request-line 4094 --limit-request-field_size 4094 --access-logfile /dev/null --error-logfile - app:production_app()
Restart=on-failure
RestartSec=3
StateDirectory=opencode-account
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/opencode-account
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_UNIX
TasksMax=48
MemoryMax=384M
[Install]
WantedBy=multi-user.target
